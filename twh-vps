            lxc delete "$VM_NAME/$DEL_SNAP"
            echo -e "${GREEN}[✓] Snapshot deleted.${NC}"
            ;;
        *) echo -e "${RED}Invalid selection!${NC}" ;;
    esac
}

apply_hyper_boost() {
    local TARGET=$1
    echo -e "${CYAN}Applying High-TPS, Zero-Buffer & BBR Hyper-Boost to $TARGET...${NC}"

    lxc config set "$TARGET" limits.cpu.priority 10 2>/dev/null || true
    lxc config set "$TARGET" limits.cpu.allowance 100% 2>/dev/null || true

    lxc exec "$TARGET" -- bash -c '
        modprobe tcp_bbr 2>/dev/null || true
        cat << "SYS" > /etc/sysctl.d/99-vm-hyper.conf
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.netdev_max_backlog = 65536
net.core.somaxconn = 32768
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fastopen = 3
vm.swappiness = 1
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
fs.file-max = 2097152
SYS
        sysctl -p /etc/sysctl.d/99-vm-hyper.conf >/dev/null 2>&1 || true

        cat << "LIMS" > /etc/security/limits.d/99-minecraft.conf
* soft nofile 1048576
* hard nofile 1048576
* soft nproc 524288
* hard nproc 524288
root soft nofile 1048576
root hard nofile 1048576
LIMS
    ' 2>/dev/null || true
    echo -e "${GREEN}[✓] $TARGET is running in Hyper-Boosted mode.${NC}"
}

live_monitor() {
    clear
    echo -e "${CYAN}${BOLD}Press [Ctrl+C] to exit Live Resource Monitor.${NC}\n"
    while true; do
        clear
        echo -e "${PURPLE}${BOLD}========================================================================================${NC}"
        echo -e "${GREEN}${BOLD}             ⚡ TWH AYUSH VPS MAKER - LIVE RESOURCE MONITOR ⚡                          ${NC}"
        echo -e "${YELLOW}${BOLD}                            Made By TWH AYUSH                                           ${NC}"
        echo -e "${PURPLE}${BOLD}========================================================================================${NC}"
        printf "%-18s %-12s %-18s %-14s %-16s\n" "INSTANCE" "STATUS" "IPV4" "CPU USAGE" "MEMORY USAGE"
        echo "----------------------------------------------------------------------------------------"

        while IFS=, read -r NAME STATUS IPV4; do
            [ -z "$NAME" ] && continue
            if [ "$STATUS" == "RUNNING" ]; then
                MEM_USAGE=$(lxc info "$NAME" | grep "Memory (current):" | awk '{print $3}' || echo "N/A")
                CPU_USAGE=$(lxc info "$NAME" | grep "CPU usage (user):" | awk '{print $4}' || echo "N/A")
            else
                MEM_USAGE="0MB"
                CPU_USAGE="0s"
            fi
            [ -z "$IPV4" ] && IPV4="None"
            printf "%-18s %-12s %-18s %-14s %-16s\n" "$NAME" "$STATUS" "$IPV4" "$CPU_USAGE" "$MEM_USAGE"
        done < <(lxc list -c ns4 --format csv)

        echo -e "${PURPLE}${BOLD}========================================================================================${NC}"
        echo -e "${YELLOW}Host CPU Arch:${NC} $CPU_ARCH | ${YELLOW}Host IP:${NC} $HOST_PRIMARY_IP | ${YELLOW}Free RAM:${NC} $(free -h | awk '/^Mem:/ {print $4 "/" $2}')"
        echo "Refreshing live every 2 seconds..."
        sleep 2
    done
}

