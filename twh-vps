port_forward_nat() {
    echo -e "\n${CYAN}${BOLD}=== 🌐 INTERACTIVE NAT PORT FORWARDING PROXY ===${NC}"
    read -p "Enter Target Instance Name: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi

    read -p "Enter Host External Port (e.g. 25565): " HOST_PORT
    read -p "Enter Instance Internal Port [Default: $HOST_PORT]: " VM_PORT
    VM_PORT=${VM_PORT:-$HOST_PORT}
    read -p "Protocol (tcp/udp) [Default: tcp]: " PROTO
    PROTO=${PROTO:-tcp}

    DEV_NAME="proxy-${PROTO}-${HOST_PORT}"
    lxc config device add "$VM_NAME" "$DEV_NAME" proxy \
        listen="${PROTO}:0.0.0.0:${HOST_PORT}" \
        connect="${PROTO}:127.0.0.1:${VM_PORT}"

    echo -e "${GREEN}[✓] Port mapped successfully!${NC}"
    echo -e " • Forwarding: ${HOST_PRIMARY_IP}:${HOST_PORT} -> ${VM_NAME}:${VM_PORT} (${PROTO})"
}

clone_instance() {
    echo -e "\n${CYAN}${BOLD}=== 📋 INSTANT CONTAINER & VM CLONE FACTORY ===${NC}"
    read -p "Enter Existing Instance to Clone From: " SRC_NAME
    if ! lxc info "$SRC_NAME" &>/dev/null; then
        echo -e "${RED}Error: Source '$SRC_NAME' not found!${NC}"; return
    fi

    read -p "Enter New Instance Name: " DEST_NAME
    if lxc info "$DEST_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$DEST_NAME' already exists!${NC}"; return
    fi

    echo -e "${YELLOW}Cloning $SRC_NAME to $DEST_NAME...${NC}"
    lxc copy "$SRC_NAME" "$DEST_NAME"
    lxc start "$DEST_NAME"

    echo -e "${GREEN}[✓] Successfully cloned and started $DEST_NAME!${NC}"
}

toggle_suspend() {
    echo -e "\n${CYAN}${BOLD}=== ⏸️ FREEZE / UNFREEZE (CGROUP SUSPEND ENGINE) ===${NC}"
    read -p "Enter Instance Name: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi

    CURRENT_STATUS=$(lxc info "$VM_NAME" | grep "Status:" | awk '{print $2}')
    if [ "$CURRENT_STATUS" == "RUNNING" ]; then
        lxc pause "$VM_NAME"
        echo -e "${YELLOW}[✓] Instance $VM_NAME is now FROZEN (Memory state preserved in RAM).${NC}"
    elif [ "$CURRENT_STATUS" == "FROZEN" ]; then
        lxc resume "$VM_NAME"
        echo -e "${GREEN}[✓] Instance $VM_NAME is now RESUMED and running!${NC}"
    else
        echo -e "${RED}Instance is $CURRENT_STATUS. It must be RUNNING to freeze or FROZEN to resume.${NC}"
    fi
}

toggle_watchdog() {
    echo -e "\n${CYAN}${BOLD}=== 🛡️ AUTO-WATCHDOG CRASH HEALER DAEMON ===${NC}"
    echo "1) Install & Enable Background Watchdog Daemon"
    echo "2) Disable & Remove Watchdog Daemon"
    read -p "Select [1/2]: " WD_OPT

    if [ "$WD_OPT" == "1" ]; then
        cat << 'EOF_WD' > /usr/local/bin/twh-watchdog.sh
#!/usr/bin/env bash
while true; do
    for vm in $(lxc list -c n --format csv 2>/dev/null); do
        AUTOSTART=$(lxc config get "$vm" boot.autostart 2>/dev/null || echo "")
        STATUS=$(lxc info "$vm" 2>/dev/null | grep "Status:" | awk '{print $2}')
        if [ "$AUTOSTART" == "true" ] && [ "$STATUS" == "STOPPED" ]; then
            lxc start "$vm" 2>/dev/null || true
        fi
    done
    sleep 30
done
EOF_WD
        chmod +x /usr/local/bin/twh-watchdog.sh

        cat << 'EOF_UNIT' > /etc/systemd/system/twh-watchdog.service
[Unit]
Description=Twh Ayush Instance Crash Auto-Healer Watchdog
After=snap.lxd.daemon.service

[Service]
Type=simple
ExecStart=/usr/local/bin/twh-watchdog.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF_UNIT

        systemctl daemon-reload
        systemctl enable --now twh-watchdog.service
        echo -e "${GREEN}[✓] Auto-Watchdog active! Any autostart instance that crashes will be revived within 30 seconds.${NC}"
    elif [ "$WD_OPT" == "2" ]; then
        systemctl disable --now twh-watchdog.service 2>/dev/null || true
        rm -f /etc/systemd/system/twh-watchdog.service /usr/local/bin/twh-watchdog.sh
        systemctl daemon-reload
        echo -e "${YELLOW}[✓] Watchdog daemon removed.${NC}"
    fi
}

