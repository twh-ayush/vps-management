set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

BRIDGE="furious-br0"

HOST_IFACE=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n1)
[ -z "$HOST_IFACE" ] && HOST_IFACE="eth0"
HOST_PRIMARY_IP=$(ip -4 addr show "$HOST_IFACE" 2>/dev/null | grep inet | awk '{print $2}' | cut -d'/' -f1 | head -n1)
HOST_GATEWAY=$(ip route show default 2>/dev/null | awk '{print $3}' | head -n1)

detect_hardware() {
    CPU_VENDOR=$(grep -m 1 'vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}' || echo "Generic")
    if [ "$CPU_VENDOR" == "AuthenticAMD" ]; then
        CPU_ARCH="AMD"
        KVM_MOD="kvm_amd"
    else
        CPU_ARCH="Intel"
        KVM_MOD="kvm_intel"
    fi
}

ensure_infrastructure() {
    detect_hardware
    modprobe kvm 2>/dev/null || true
    modprobe "$KVM_MOD" 2>/dev/null || true
    modprobe vhost_net 2>/dev/null || true
    modprobe tcp_bbr 2>/dev/null || true

    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.all.proxy_arp=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.default.proxy_arp=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf."$HOST_IFACE".proxy_arp=1 >/dev/null 2>&1 || true

    iptables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
    iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true

    if ! ip link show "$BRIDGE" &>/dev/null; then
        lxc network create "$BRIDGE" ipv4.address=10.99.0.1/24 ipv4.nat=true ipv6.address=none 2>/dev/null || true
    fi

    systemctl enable snap.lxd.daemon 2>/dev/null || true
    systemctl enable snap.lxd.activate 2>/dev/null || true
}

get_subnet_free_ip() {
    SUBNET_CIDR=$(ip -4 addr show "$HOST_IFACE" 2>/dev/null | grep inet | awk '{print $2}' | head -n1)
    if [ -z "$SUBNET_CIDR" ]; then
        echo ""
        return
    fi

    PREFIX=$(echo "$SUBNET_CIDR" | cut -d'/' -f2)
    BASE_IP=$(echo "$SUBNET_CIDR" | cut -d'/' -f1)
    IFS=. read -r i1 i2 i3 i4 <<< "$BASE_IP"

    declare -A USED_IPS
    [ -n "$HOST_PRIMARY_IP" ] && USED_IPS["$HOST_PRIMARY_IP"]=1
    [ -n "$HOST_GATEWAY" ] && USED_IPS["$HOST_GATEWAY"]=1

    for inst in $(lxc list -c n --format csv 2>/dev/null); do
        local ip=$(lxc config device get "$inst" public-ip ipv4.address 2>/dev/null || echo "")
        [ -n "$ip" ] && USED_IPS["$ip"]=1
    done

    if [ "$PREFIX" -ge 24 ]; then
        START_OCTET=$(( (i4 / 16) * 16 + 1 ))
        END_OCTET=$(( START_OCTET + 13 ))
        for ((oct=START_OCTET; oct<=END_OCTET; oct++)); do
            CANDIDATE="$i1.$i2.$i3.$oct"
            if [ -z "${USED_IPS[$CANDIDATE]}" ]; then
                echo "$CANDIDATE"
                return
            fi
        done
    fi
    echo ""
}

deploy_vps() {
    echo -e "\n${CYAN}${BOLD}=== 🚀 TWH AYUSH - DEPLOY NEW INSTANCE ===${NC}"
    echo -e "${YELLOW}${BOLD}               Made By TWH AYUSH            ${NC}"
    read -p "Enter Instance Name: " VM_NAME
    if lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' already exists!${NC}"
        return
    fi

    echo -e "\nSelect Virtualization Architecture:"
    echo "1) High-Performance LXC Container (0% virtualization overhead, best for Minecraft nodes & Wings)"
    echo "2) True Hardware KVM Virtual Machine (Complete kernel isolation, dedicated OS kernel)"
    read -p "Option [1/2]: " TYPE_CHOICE

    read -p "Dedicated CPU Cores [Default: 4]: " VM_CPU; VM_CPU=${VM_CPU:-4}
    read -p "RAM Allocation [Default: 8GB]: " VM_RAM; VM_RAM=${VM_RAM:-8GB}
    read -p "Disk Storage Size [Default: 40GB]: " VM_DISK; VM_DISK=${VM_DISK:-40GB}

    echo -e "\nSelect Network Mode:"
    echo "1) Dedicated Extra Public IPv4 (Auto-detected from subnet pool)"
    echo "2) Internal Private NAT IP (10.99.0.X)"
    read -p "Option [1/2]: " NET_MODE

    if [ "$NET_MODE" == "1" ]; then
        AUTO_IP=$(get_subnet_free_ip)
        if [ -n "$AUTO_IP" ]; then
            echo -e "${GREEN}[⚡ Auto-Discovery] Next available free IP in subnet: ${BOLD}$AUTO_IP${NC}"
            read -p "Press ENTER to use [$AUTO_IP] or type a specific IP: " USER_IP
            VM_IP=${USER_IP:-$AUTO_IP}
        else
            read -p "Enter Public IP to attach: " VM_IP
        fi
    else
        read -p "Enter Static Private IP (or press ENTER for Auto DHCP): " VM_IP
    fi

    read -p "Permanent Root Password [Default: TwhAyush123!]: " VM_PASS; VM_PASS=${VM_PASS:-TwhAyush123!}
    read -p "Custom CPU Brand String (e.g. AMD Ryzen 9 7950X, or leave blank): " CUSTOM_CPU
    read -p "Custom Branding Title [Default: Twh Ayush Cloud Node]: " BRAND_TITLE; BRAND_TITLE=${BRAND_TITLE:-Twh Ayush Cloud Node}

    echo -e "\n${YELLOW}Provisioning $VM_NAME... Please wait.${NC}"

    if [ "$TYPE_CHOICE" == "2" ]; then
        lxc launch ubuntu:24.04 "$VM_NAME" --vm \
            -c limits.cpu="$VM_CPU" \
            -c limits.memory="$VM_RAM" \
            -d root,size="$VM_DISK"
    else
        lxc launch ubuntu:24.04 "$VM_NAME" \
            -c limits.cpu="$VM_CPU" \
            -c limits.cpu.priority=10 \
            -c limits.cpu.allowance=100% \
            -c limits.memory="$VM_RAM" \
            -c security.nesting=true
            
        lxc config set "$VM_NAME" security.syscalls.intercept.mknod true 2>/dev/null || true
        lxc config set "$VM_NAME" security.syscalls.intercept.setxattr true 2>/dev/null || true
    fi

    lxc config set "$VM_NAME" boot.autostart true
    lxc config set "$VM_NAME" boot.autostart.priority 10
    lxc config set "$VM_NAME" boot.autostart.delay 2

    if [ "$NET_MODE" == "1" ] && [ -n "$VM_IP" ]; then
        ip addr del "${VM_IP}/24" dev "$HOST_IFACE" 2>/dev/null || true
        ip addr del "${VM_IP}/28" dev "$HOST_IFACE" 2>/dev/null || true
        lxc config device add "$VM_NAME" public-ip nic nictype=routed ipv4.address="$VM_IP"
    elif [ -n "$VM_IP" ]; then
        lxc network attach "$BRIDGE" "$VM_NAME" eth0 eth0 2>/dev/null || true
        lxc config device set "$VM_NAME" eth0 ipv4.address "$VM_IP"
    fi

    if [ -n "$CUSTOM_CPU" ]; then
        lxc config set "$VM_NAME" raw.qemu "-cpu host,model-id='$CUSTOM_CPU'" 2>/dev/null || true
        lxc exec "$VM_NAME" -- bash -c "
            mkdir -p /etc/profile.d
            echo 'alias lscpu=\"lscpu | sed \\\"s/Model name:.*/Model name: $CUSTOM_CPU/\\\"\"' > /etc/profile.d/cpuspoof.sh
            chmod +x /etc/profile.d/cpuspoof.sh
        " 2>/dev/null || true
    fi

    sleep 6

    lxc exec "$VM_NAME" -- bash -c "
        echo 'root:$VM_PASS' | chpasswd
        chage -M 99999 root
        apt-get update -y >/dev/null 2>&1 || true
        apt-get install -y openssh-server curl wget ethtool lsb-release htop >/dev/null 2>&1 || true
        sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/g' /etc/ssh/sshd_config 2>/dev/null || true
        sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config 2>/dev/null || true
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true

        ethtool -K eth0 tx off rx off 2>/dev/null || true
        ip link set dev eth0 txqueuelen 10000 2>/dev/null || true

        cat << 'DNS' > /etc/resolv.conf
nameserver 1.1.1.1
nameserver 8.8.8.8
DNS

        cat << 'MOTD' > /etc/update-motd.d/00-twh-header
#!/bin/sh
echo \"\e[35m\e[1m====================================================================\e[0m\"
echo \"\e[33m\e[1m    ⚡ $BRAND_TITLE ⚡\e[0m\"
echo \"\e[36m\e[1m               Made By TWH AYUSH                                    \e[0m\"
echo \"\e[32m       Instance: $VM_NAME  |  Status: ACTIVE & OPTIMIZED\e[0m\"
echo \"\e[35m\e[1m====================================================================\e[0m\"
echo \" • IP Address : \$(ip -4 addr show scope global | grep inet | awk '{print \$2}' | cut -d'/' -f1 | head -n1)\"
echo \" • Kernel     : \$(uname -r)\"
echo \" • System Load: \$(cut -d ' ' -f 1-3 /proc/loadavg)\"
echo \" • RAM Status : \$(free -m | awk '/Mem:/ { printf(\"%dMB / %dMB\", \$7, \$2) }')\"
echo \"\e[35m\e[1m--------------------------------------------------------------------\e[0m\"
MOTD
        chmod +x /etc/update-motd.d/00-twh-header
        rm -f /etc/update-motd.d/10-help-text /etc/update-motd.d/50-motd-news /etc/legal 2>/dev/null || true
    "

    apply_hyper_boost "$VM_NAME"

    echo -e "\n${GREEN}${BOLD}[✓] INSTANCE $VM_NAME PROVISIONED SUCCESSFULLY!${NC}"
    echo -e " • Assigned IP   : ${VM_IP:-$(lxc list "$VM_NAME" -c 4 --csv | awk '{print $1}')}"
    echo -e " • Root Password : $VM_PASS"
    echo -e " • SSH Login     : ssh root@${VM_IP:-$(lxc list "$VM_NAME" -c 4 --csv | awk '{print $1}')}"
}

delete_instance_with_ip() {
    echo -e "\n${RED}${BOLD}=== 🗑️ DELETE INSTANCE & PURGE ASSOCIATED IP ===${NC}"
    read -p "Enter Instance Name to DELETE: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi

    ROUTED_IP=$(lxc config device get "$VM_NAME" public-ip ipv4.address 2>/dev/null || echo "")

    read -p "Confirm permanent deletion of $VM_NAME and detachment of its IP? (yes/no): " CONFIRM
    if [ "$CONFIRM" == "yes" ]; then
        lxc stop "$VM_NAME" --force 2>/dev/null || true
        lxc delete "$VM_NAME"
        if [ -n "$ROUTED_IP" ]; then
            ip route del "$ROUTED_IP" 2>/dev/null || true
            arp -d "$ROUTED_IP" 2>/dev/null || true
            echo -e "${GREEN}[✓] IP $ROUTED_IP returned cleanly to the free pool.${NC}"
        fi
        echo -e "${GREEN}[✓] Instance $VM_NAME completely removed.${NC}"
    fi
}

live_resource_scaler() {
    echo -e "\n${CYAN}${BOLD}=== ⚡ LIVE ZERO-DOWNTIME RESOURCE SCALER ===${NC}"
    read -p "Enter Instance Name: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi

    echo "1) Hot-Resize CPU Cores"
    echo "2) Hot-Resize RAM Memory"
    echo "3) Live Disk Quota Expansion"
    read -p "Select [1-3]: " SCALE_OPT

    case "$SCALE_OPT" in
        1)
            read -p "Enter new CPU core count: " NEW_CPU
            lxc config set "$VM_NAME" limits.cpu "$NEW_CPU"
            echo -e "${GREEN}[✓] CPU cores adjusted to $NEW_CPU live!${NC}"
            ;;
        2)
            read -p "Enter new RAM limit (e.g. 16GB): " NEW_RAM
            lxc config set "$VM_NAME" limits.memory "$NEW_RAM"
            echo -e "${GREEN}[✓] RAM dynamically adjusted to $NEW_RAM live!${NC}"
            ;;
        3)
            read -p "Enter new Disk size (e.g. 80GB): " NEW_DISK
            lxc config device set "$VM_NAME" root size "$NEW_DISK"
            echo -e "${GREEN}[✓] Storage quota expanded to $NEW_DISK on the fly!${NC}"
            ;;
        *) echo -e "${RED}Invalid selection!${NC}" ;;
    esac
}

snapshot_and_rollback() {
    echo -e "\n${CYAN}${BOLD}=== 💾 INSTANT SNAPSHOT & ROLLBACK ENGINE ===${NC}"
    read -p "Enter Instance Name: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi

    echo "1) Create Instant Live Snapshot"
    echo "2) 1-Click Rollback to Snapshot"
    echo "3) List Existing Snapshots"
    echo "4) Delete a Snapshot"
    read -p "Select [1-4]: " SNAP_OPT

    case "$SNAP_OPT" in
        1)
            SNAP_NAME="snap-$(date +%Y%m%d-%H%M%S)"
            lxc snapshot "$VM_NAME" "$SNAP_NAME"
            echo -e "${GREEN}[✓] Snapshot '$SNAP_NAME' created in 1 second!${NC}"
            ;;
        2)
            lxc info "$VM_NAME" | grep -A 20 "Snapshots:" || echo "No snapshots available."
            read -p "Enter Snapshot Name to RESTORE: " TARGET_SNAP
            lxc restore "$VM_NAME" "$TARGET_SNAP"
            echo -e "${GREEN}[✓] Restored $VM_NAME to '$TARGET_SNAP'!${NC}"
            ;;
        3)
            lxc info "$VM_NAME" | grep -A 20 "Snapshots:" || echo "No snapshots found."
            ;;
        4)
            read -p "Enter Snapshot Name to DELETE: " DEL_SNAP
            lxc delete "$VM_NAME/$DEL_SNAP"
            echo -e "${GREEN}[✓] Snapshot deleted.${NC}"
            ;;
        *) echo -e "${RED}Invalid selection!${NC}" ;;
    esac
}

apply_hyper_boost() {
    local TARGET=$1
    echo -e "${CYAN}Applying High-TPS, Zero-Buffer & BBR Hyper-Boost to $TARGET...${NC}"

    lxc config set "$TARGET" limits.cpu.priority 10 2>/dev/null || true
    lxc config set "$TARGET" limits.cpu.allowance 100% 2>/dev/null || true

    lxc exec "$TARGET" -- bash -c '
        modprobe tcp_bbr 2>/dev/null || true
        cat << "SYS" > /etc/sysctl.d/99-vm-hyper.conf
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.netdev_max_backlog = 65536
net.core.somaxconn = 32768
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fastopen = 3
vm.swappiness = 1
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
fs.file-max = 2097152
SYS
        sysctl -p /etc/sysctl.d/99-vm-hyper.conf >/dev/null 2>&1 || true

        cat << "LIMS" > /etc/security/limits.d/99-minecraft.conf
* soft nofile 1048576
* hard nofile 1048576
* soft nproc 524288
* hard nproc 524288
root soft nofile 1048576
root hard nofile 1048576
LIMS
    '
    echo -e "${GREEN}[✓] $TARGET is running in Hyper-Boosted mode.${NC}"
}

live_monitor() {
    clear
    echo -e "${CYAN}${BOLD}Press [Ctrl+C] to exit Live Resource Monitor.${NC}\n"
    while true; do
        clear
        echo -e "${PURPLE}${BOLD}========================================================================================${NC}"
        echo -e "${GREEN}${BOLD}             ⚡ TWH AYUSH VPS MAKER - LIVE RESOURCE MONITOR ⚡                          ${NC}"
        echo -e "${YELLOW}${BOLD}                            Made By TWH AYUSH                                           ${NC}"
        echo -e "${PURPLE}${BOLD}========================================================================================${NC}"
        printf "%-18s %-12s %-18s %-14s %-16s\n" "INSTANCE" "STATUS" "IPV4" "CPU USAGE" "MEMORY USAGE"
        echo "----------------------------------------------------------------------------------------"

        while IFS=, read -r NAME STATUS IPV4; do
            [ -z "$NAME" ] && continue
            if [ "$STATUS" == "RUNNING" ]; then
                MEM_USAGE=$(lxc info "$NAME" | grep "Memory (current):" | awk '{print $3}' || echo "N/A")
                CPU_USAGE=$(lxc info "$NAME" | grep "CPU usage (user):" | awk '{print $4}' || echo "N/A")
            else
                MEM_USAGE="0MB"
                CPU_USAGE="0s"
            fi
            [ -z "$IPV4" ] && IPV4="None"
            printf "%-18s %-12s %-18s %-14s %-16s\n" "$NAME" "$STATUS" "$IPV4" "$CPU_USAGE" "$MEM_USAGE"
        done < <(lxc list -c ns4 --format csv)

        echo -e "${PURPLE}${BOLD}========================================================================================${NC}"
        echo -e "${YELLOW}Host CPU Arch:${NC} $CPU_ARCH | ${YELLOW}Host IP:${NC} $HOST_PRIMARY_IP | ${YELLOW}Free RAM:${NC} $(free -h | awk '/^Mem:/ {print $4 "/" $2}')"
        echo "Refreshing live every 2 seconds..."
        sleep 2
    done
}

change_password_permanent() {
    read -p "Enter Instance Name: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi
    read -p "Enter New Permanent Root Password: " NEW_PASS
    lxc exec "$VM_NAME" -- bash -c "
        echo 'root:$NEW_PASS' | chpasswd
        chage -M 99999 root
        sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/g' /etc/ssh/sshd_config 2>/dev/null || true
        sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config 2>/dev/null || true
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
    "
    echo -e "${GREEN}[✓] Permanent password updated for $VM_NAME.${NC}"
}

change_cpu_name() {
    read -p "Enter Instance Name: " VM_NAME
    if ! lxc info "$VM_NAME" &>/dev/null; then
        echo -e "${RED}Error: Instance '$VM_NAME' not found!${NC}"; return
    fi
    read -p "Enter CPU Model String: " CPU_STR
    lxc config set "$VM_NAME" raw.qemu "-cpu host,model-id='$CPU_STR'" 2>/dev/null || true
    lxc exec "$VM_NAME" -- bash -c "
        mkdir -p /etc/profile.d
        echo 'alias lscpu=\"lscpu | sed \\\"s/Model name:.*/Model name: $CPU_STR/\\\"\"' > /etc/profile.d/cpuspoof.sh
        chmod +x /etc/profile.d/cpuspoof.sh
    " 2>/dev/null || true
    echo -e "${GREEN}[✓] CPU model name spoofed to '$CPU_STR' on $VM_NAME.${NC}"
}

